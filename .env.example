# ---- LLM provider configuration -------------------------------------------
# "openai" or "anthropic"
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Demo mode --------------------------------------------------------------
# When true, the app uses deterministic synthetic evaluations instead of a real
# LLM call, so it can be demonstrated without any API key. Never treat demo
# output as a real evaluation.
DEMO_MODE=false

# ---- Database ----------------------------------------------------------------
DATABASE_PATH=data/app.db
